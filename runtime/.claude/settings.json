{
  "permissions": {
    "allow": [
      "mcp__gw-tl__*",
      "mcp__gw-ds__*",
      "mcp__gw-am__*",
      "mcp__gw-ig__*",
      "mcp__gw-pam__*",
      "Agent",
      "Skill(access-request-evaluation)",
      "Skill(group-change)",
      "Skill(joiner-mover-leaver)",
      "Skill(lockout-triage)",
      "Skill(mfa-reset)",
      "Skill(pam-package)",
      "Skill(password-reset)",
      "Skill(routing)"
    ],
    "deny": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "PowerShell",
      "ToolSearch",
      "Monitor",
      "SendMessage",
      "TaskStop",
      "TaskOutput",
      "CronCreate",
      "CronList",
      "CronDelete",
      "EnterWorktree",
      "ExitWorktree",
      "RemoteTrigger",
      "ListAgents",
      "ReportFindings",
      "PushNotification",
      "TodoWrite"
    ]
  },
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project .. python -m iamagents.hooks.domain_guard"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project .. python -m iamagents.hooks.hop_limit"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project .. python -m iamagents.hooks.trace"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project .. python -m iamagents.hooks.result_schema"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project .. python -m iamagents.hooks.result_schema"
          }
        ]
      }
    ]
  },
  "claudeMdExcludes": [
    "**/CLAUDE.md"
  ],
  "autoMemoryEnabled": false
}
