# Copy to .env. Never commit .env, certificates or real tenant ids.

TENANT_ID=00000000-0000-0000-0000-000000000000

# One app registration per agent. The gateway holds the certificates.
DS_CLIENT_ID=
DS_CERT_PATH=certs/iam-agent-ds.pem
AM_CLIENT_ID=
AM_CERT_PATH=certs/iam-agent-am.pem
IG_CLIENT_ID=
IG_CERT_PATH=certs/iam-agent-ig.pem
PAM_CLIENT_ID=
PAM_CERT_PATH=certs/iam-agent-pam.pem

# Bearer tokens the agent files send to the gateway (generated by the token issuing script).
DS_GATEWAY_TOKEN=
AM_GATEWAY_TOKEN=
IG_GATEWAY_TOKEN=
PAM_GATEWAY_TOKEN=
TL_GATEWAY_TOKEN=

GATEWAY_URL=http://127.0.0.1:8765/mcp

# Gateway mode: plan (writes recorded, not sent) or live
GATEWAY_MODE=plan

# Audit and trace log retention in days
LOG_RETENTION_DAYS=90
