# Copy to .env. Never commit .env, certificates or real tenant ids.

TENANT_ID=00000000-0000-0000-0000-000000000000

# One app registration per agent. The gateway holds the certificates.
DS_CLIENT_ID=
DS_CERT_PATH=certs/iam-agent-ds.pem
AM_CLIENT_ID=
AM_CERT_PATH=certs/iam-agent-am.pem
IG_CLIENT_ID=
IG_CERT_PATH=certs/iam-agent-ig.pem
PAM_CLIENT_ID=
PAM_CERT_PATH=certs/iam-agent-pam.pem

# Bearer tokens the agent files send to the gateway (generated by the token issuing script).
GW_TOKEN_DS=
GW_TOKEN_AM=
GW_TOKEN_IG=
GW_TOKEN_PAM=
GW_TOKEN_TL=

# Token for the local admin endpoint the harness uses to bind the active ticket. Must differ from every agent token.
GW_ADMIN_TOKEN=
GATEWAY_ADMIN_PORT=8766

GATEWAY_URL=http://127.0.0.1:8765/mcp

# Gateway mode: plan (writes recorded, not sent) or live
GATEWAY_MODE=plan

# Audit and trace log retention in days
LOG_RETENTION_DAYS=90

# Undelivered outbox secrets (temporary passwords) are wiped after this many hours.
# Delivered ones are wiped on delivery.
OUTBOX_TTL_HOURS=24

# The tenant domain (for example yourtenant.onmicrosoft.com). Only here, never in a committed
# file: the repo uses the placeholder <tenant>.onmicrosoft.com and maps this value in at runtime.
TENANT_DOMAIN=
